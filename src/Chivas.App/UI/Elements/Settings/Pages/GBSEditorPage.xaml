<ui:UiPage x:Class="Chivas.UI.Elements.Settings.Pages.GBSEditorPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:models="clr-namespace:Chivas.UI.ViewModels" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:resources="clr-namespace:Chivas.Resources" xmlns:controls="clr-namespace:Chivas.UI.Elements.Controls" xmlns:sys="clr-namespace:System;assembly=mscorlib" Title="GBSEditor" Scrollable="True" xmlns:pages="clr-namespace:Chivas.UI.Elements.Settings.Pages">
  <ui:UiPage.Resources>
    <Style x:Key="SectionHeading" TargetType="{x:Type TextBlock}">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="0,26,0,0" />
    </Style>
  </ui:UiPage.Resources>
  <StackPanel Margin="0,0,14,14">
    <TextBlock Margin="0,0,0,2" FontSize="14" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Global_Page_Subtitle}" />

    <TextBlock Style="{StaticResource SectionHeading}" Text="{x:Static resources:Strings.Menu_Global_Page_SettingsFile}" />
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_LockFile}" Description="{x:Static resources:Strings.Menu_Global_Page_LockFileDesc}">
      <ui:ToggleSwitch IsChecked="{Binding SettingsFileReadOnly, Mode=TwoWay}" />
    </controls:OptionControl>

    <TextBlock Style="{StaticResource SectionHeading}" Text="{x:Static resources:Strings.Menu_Global_Page_Interface}" />
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_UITransparency}" Description="{x:Static resources:Strings.Menu_Global_Page_UITransparencyDesc}">
      <StackPanel Orientation="Horizontal">
        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding UITransparency, Mode=TwoWay}" Width="200" />
        <TextBlock MinWidth="42" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding UITransparency, StringFormat={}{0:P0}}" />
      </StackPanel>
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_TextSize}" Description="{x:Static resources:Strings.Menu_Global_Page_TextSizeDesc}">
      <ComboBox SelectedValuePath="Tag" Width="200" SelectedValue="{Binding PreferredTextSize, Mode=TwoWay}">
        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Global_Page_Small}"><FrameworkElement.Tag><sys:Int32>0</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Global_Page_Normal}"><FrameworkElement.Tag><sys:Int32>1</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Global_Page_Large}"><FrameworkElement.Tag><sys:Int32>2</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
      </ComboBox>
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_ReducedMotion}" Description="{x:Static resources:Strings.Menu_Global_Page_ReducedMotionDesc}">
      <ui:ToggleSwitch IsChecked="{Binding ReducedMotion, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_HUD}" Description="{x:Static resources:Strings.Menu_Global_Page_HUDDesc}">
      <ui:ToggleSwitch IsChecked="{Binding HudVisible, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_ChatVisibility}" Description="{x:Static resources:Strings.Menu_Global_Page_ChatVisibilityDesc}">
      <ui:ToggleSwitch IsChecked="{Binding ChatVisible, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_PlayerNames}" Description="{x:Static resources:Strings.Menu_Global_Page_PlayerNamesDesc}">
      <ui:ToggleSwitch IsChecked="{Binding PlayerNamesEnabled, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_Badge}" Description="{x:Static resources:Strings.Menu_Global_Page_BadgeDesc}">
      <ui:ToggleSwitch IsChecked="{Binding BadgeVisible, Mode=TwoWay}" />
    </controls:OptionControl>

    <TextBlock Style="{StaticResource SectionHeading}" Text="{x:Static resources:Strings.Menu_Global_Page_Graphics}" />
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_FramerateCap}" Description="{x:Static resources:Strings.Menu_Global_Page_FramerateCapDesc}">
      <ui:TextBox Width="100" MaxLength="5" PreviewTextInput="ValidateUInt32" Text="{Binding FramerateCap, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_GraphicsQuality}" Description="{x:Static resources:Strings.Menu_Global_Page_GraphicsQualityDesc}">
      <ComboBox SelectedValuePath="Tag" Width="200" SelectedValue="{Binding GraphicsQuality, Mode=TwoWay}">
        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Global_Page_Automatic}"><FrameworkElement.Tag><sys:Int32>0</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Global_Page_Lowest1}"><FrameworkElement.Tag><sys:Int32>1</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="2"><FrameworkElement.Tag><sys:Int32>2</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="3"><FrameworkElement.Tag><sys:Int32>3</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="4"><FrameworkElement.Tag><sys:Int32>4</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="5"><FrameworkElement.Tag><sys:Int32>5</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="6"><FrameworkElement.Tag><sys:Int32>6</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="7"><FrameworkElement.Tag><sys:Int32>7</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="8"><FrameworkElement.Tag><sys:Int32>8</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="9"><FrameworkElement.Tag><sys:Int32>9</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Global_Page_Highest10}"><FrameworkElement.Tag><sys:Int32>10</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
      </ComboBox>
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_Fullscreen}" Description="{x:Static resources:Strings.Menu_Global_Page_FullscreenDesc}">
      <ui:ToggleSwitch IsChecked="{Binding Fullscreen, Mode=TwoWay}" />
    </controls:OptionControl>

    <TextBlock Style="{StaticResource SectionHeading}" Text="{x:Static resources:Strings.Menu_Global_Page_Audio}" />
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_MasterVolume}" Description="{x:Static resources:Strings.Menu_Global_Page_MasterVolumeDesc}">
      <StackPanel Orientation="Horizontal">
        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding MasterVolume, Mode=TwoWay}" Width="200" />
        <TextBlock MinWidth="42" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding MasterVolume, StringFormat={}{0:P0}}" />
      </StackPanel>
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_VoiceVolume}" Description="{x:Static resources:Strings.Menu_Global_Page_VoiceVolumeDesc}">
      <StackPanel Orientation="Horizontal">
        <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding VoiceChatVolume, Mode=TwoWay}" Width="200" />
        <TextBlock MinWidth="42" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding VoiceChatVolume, StringFormat={}{0:P0}}" />
      </StackPanel>
    </controls:OptionControl>

    <TextBlock Style="{StaticResource SectionHeading}" Text="{x:Static resources:Strings.Menu_Global_Page_Input}" />
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_MouseSens}" Description="{x:Static resources:Strings.Menu_Global_Page_MouseSensDesc}">
      <ui:TextBox Width="100" MaxLength="6" PreviewTextInput="ValidateFloat" Text="{Binding MouseSensitivity, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_InvertY}" Description="{x:Static resources:Strings.Menu_Global_Page_InvertYDesc}">
      <ui:ToggleSwitch IsChecked="{Binding CameraYInverted, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_GamepadSens}" Description="{x:Static resources:Strings.Menu_Global_Page_GamepadSensDesc}">
      <StackPanel Orientation="Horizontal">
        <Slider Minimum="0.1" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding GamepadSensitivity, Mode=TwoWay}" Width="200" />
        <TextBlock MinWidth="42" Margin="10,0,0,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding GamepadSensitivity, StringFormat={}{0:0.0}}" />
      </StackPanel>
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_Vibration}" Description="{x:Static resources:Strings.Menu_Global_Page_VibrationDesc}">
      <ui:ToggleSwitch IsChecked="{Binding ControllerVibration, Mode=TwoWay}" />
    </controls:OptionControl>

    <TextBlock Style="{StaticResource SectionHeading}" Text="{x:Static resources:Strings.Menu_Global_Page_Network}" />
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_NetStats}" Description="{x:Static resources:Strings.Menu_Global_Page_NetStatsDesc}">
      <ui:ToggleSwitch IsChecked="{Binding NetworkStatsVisible, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_ChatTranslation}" Description="{x:Static resources:Strings.Menu_Global_Page_ChatTranslationDesc}">
      <ui:ToggleSwitch IsChecked="{Binding ChatTranslationEnabled, Mode=TwoWay}" />
    </controls:OptionControl>

    <TextBlock Style="{StaticResource SectionHeading}" Text="{x:Static resources:Strings.Menu_Global_Page_VR}" />
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_EnableVR}" Description="{x:Static resources:Strings.Menu_Global_Page_EnableVRDesc}">
      <ui:ToggleSwitch IsChecked="{Binding VREnabled, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_VRComfort}" Description="{x:Static resources:Strings.Menu_Global_Page_VRComfortDesc}">
      <ComboBox SelectedValuePath="Tag" Width="200" SelectedValue="{Binding VRComfortSetting, Mode=TwoWay}">
        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Global_Page_Comfort}"><FrameworkElement.Tag><sys:Int32>1</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Global_Page_Normal}"><FrameworkElement.Tag><sys:Int32>2</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
        <ComboBoxItem Content="{x:Static resources:Strings.Menu_Global_Page_Intense}"><FrameworkElement.Tag><sys:Int32>3</sys:Int32></FrameworkElement.Tag></ComboBoxItem>
      </ComboBox>
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_Vignette}" Description="{x:Static resources:Strings.Menu_Global_Page_VignetteDesc}">
      <ui:ToggleSwitch IsChecked="{Binding VignetteEnabled, Mode=TwoWay}" />
    </controls:OptionControl>

    <TextBlock Style="{StaticResource SectionHeading}" Text="{x:Static resources:Strings.Menu_Global_Page_Advanced}" />
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_MicroProfiler}" Description="{x:Static resources:Strings.Menu_Global_Page_MicroProfilerDesc}">
      <ui:ToggleSwitch IsChecked="{Binding MicroProfilerWebServerEnabled, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_ScreenProfiler}" Description="{x:Static resources:Strings.Menu_Global_Page_ScreenProfilerDesc}">
      <ui:ToggleSwitch IsChecked="{Binding OnScreenProfilerEnabled, Mode=TwoWay}" />
    </controls:OptionControl>
    <controls:OptionControl Header="{x:Static resources:Strings.Menu_Global_Page_ResetDefaults}" Description="{x:Static resources:Strings.Menu_Global_Page_ResetDefaultsDesc}">
      <Button Content="{x:Static resources:Strings.Menu_Global_Page_Reset}" Width="120" Command="{Binding ResetToDefaultsCommand}" />
    </controls:OptionControl>
  </StackPanel>
</ui:UiPage>
