<ui:UiPage x:Class="Chivas.UI.Elements.Settings.Pages.ModsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Chivas.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Chivas.UI.ViewModels" xmlns:pages="clr-namespace:Chivas.UI.Elements.Settings.Pages" xmlns:resources="clr-namespace:Chivas.Resources" xmlns:conv="clr-namespace:Chivas.Converters" xmlns:converters="clr-namespace:Chivas.UI.Converters" xmlns:settings="clr-namespace:Chivas.UI.ViewModels.Settings" xmlns:platform="clr-namespace:Chivas.UI" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:gif="clr-namespace:WpfAnimatedGif;assembly=WpfAnimatedGif" Title="ModsPage" Scrollable="True">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
      <conv:EnumNotEqualsVisibilityConverter x:Key="EnumNotEqualsVisibilityConverter" />
      <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
      <DataTemplate x:Key="CursorSlotRow">
        <Border Margin="0,0,0,6" Padding="12,8" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Width="36" Height="36" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
              <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding Preview}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
              <TextBlock FontSize="14" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
              <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Hint}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
              <ui:Button Icon="DocumentAdd16" Content="{x:Static resources:Strings.Menu_Mods_Page_Choose}" Command="{Binding ChooseCommand}" />
              <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="{x:Static resources:Strings.Menu_Mods_Page_Remove}" Command="{Binding ClearCommand}" Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <StackPanel Margin="0,0,14,14">
    <StackPanel Visibility="{Binding MainContentVisibility}">
      <TextBlock FontSize="14" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Mods_Description}" TextWrapping="Wrap" />
      <UniformGrid Margin="0,16,0,0" Rows="1" VerticalAlignment="Stretch">
        <UniformGrid.Resources>
          <Style TargetType="{x:Type ui:CardAction}" BasedOn="{StaticResource {x:Type ui:CardAction}}">
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
          </Style>
        </UniformGrid.Resources>
        <ui:CardAction Margin="0,0,4,0" Icon="DocumentTextToolbox24" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/games/2879">
          <StackPanel>
            <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Mods_Page_FindMods}" FontWeight="Medium" />
            <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Mods_Page_FindModsDesc}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Name="OpenModFolderCardAction" Margin="4,0,4,0" Icon="Folder24" Command="{Binding OpenModsFolderCommand}">
          <StackPanel>
            <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Mods_OpenModsFolder_Title}" TextWrapping="Wrap" FontWeight="Medium" />
            <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Mods_OpenModsFolder_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardAction>
        <ui:CardAction Margin="4,0,0,0" Icon="DocumentSearch24" Command="{Binding ToggleModExplorerCommand}">
          <StackPanel>
            <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Mods_Page_ModExplorer}" FontWeight="Medium" />
            <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Mods_Page_ModExplorerDesc}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
          </StackPanel>
        </ui:CardAction>
      </UniformGrid>
      <TabControl Name="ModsTabs" Margin="0,16,0,0">
        <TabItem FontWeight="Medium">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="Color24" Margin="0,0,6,0" />
              <TextBlock Text="{x:Static resources:Strings.Menu_Mods_Page_TabCustomize}" />
            </StackPanel>
          </TabItem.Header>
          <StackPanel Margin="12">
            <controls:OptionControl Description="{x:Static resources:Strings.Menu_Mods_Page_ApplyModsDesc}" Header="{x:Static resources:Strings.Menu_Mods_Page_ApplyModsTo}">
              <ComboBox Width="200" Margin="5,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding ModApplyTargets, Mode=OneTime}" SelectedItem="{Binding ModApplyTarget, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
            </controls:OptionControl>

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Mods_Page_SectionCursor}" />
                        <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Page_CursorStyleHeader}" Description="{x:Static resources:Strings.Menu_Mods_Page_CursorStyleDesc}">
              <ComboBox Width="220" Padding="10,5,10,5" ItemsSource="{Binding CursorSettings.Styles, Mode=OneTime}" SelectedItem="{Binding CursorSettings.SelectedStyle, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
            </controls:OptionControl>
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Page_CustomCursorHeader}" Description="{x:Static resources:Strings.Menu_Mods_Page_CustomCursorDesc}">
              <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                  <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CursorSettings.Pointer.Preview}" />
                </Border>
                <ui:Button Icon="DocumentAdd16" Content="{x:Static resources:Strings.Menu_Mods_Page_Choose}" Command="{Binding CursorSettings.ChooseCustomCursorCommand}" />
                <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="{x:Static resources:Strings.Menu_Mods_Page_Remove}" Command="{Binding CursorSettings.RemoveCustomCursorCommand}" Visibility="{Binding CursorSettings.HasCustomCursor, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </controls:OptionControl>
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Page_DragCursorHeader}" Description="{x:Static resources:Strings.Menu_Mods_Page_DragCursorDesc}">
              <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                  <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CursorSettings.Drag.Preview}" />
                </Border>
                <ui:Button Icon="DocumentAdd16" Content="{x:Static resources:Strings.Menu_Mods_Page_Choose}" Command="{Binding CursorSettings.Drag.ChooseCommand}" />
                <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="{x:Static resources:Strings.Menu_Mods_Page_Remove}" Command="{Binding CursorSettings.Drag.ClearCommand}" Visibility="{Binding CursorSettings.Drag.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </controls:OptionControl>
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Page_ShiftlockHeader}" Description="{x:Static resources:Strings.Menu_Mods_Page_ShiftlockDesc}">
              <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" Margin="0,0,10,0" CornerRadius="6" Background="#33000000" BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                  <Image Margin="4" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding CursorSettings.ShiftLock.Preview}" />
                </Border>
                <ui:Button Icon="DocumentAdd16" Content="{x:Static resources:Strings.Menu_Mods_Page_Choose}" Command="{Binding CursorSettings.ShiftLock.ChooseCommand}" />
                <ui:Button Margin="8,0,0,0" Appearance="Danger" Icon="Delete16" Content="{x:Static resources:Strings.Menu_Mods_Page_Remove}" Command="{Binding CursorSettings.ShiftLock.ClearCommand}" Visibility="{Binding CursorSettings.ShiftLock.HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
              </StackPanel>
            </controls:OptionControl>
            <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
              <HeaderedContentControl.Header>
                <StackPanel>
                  <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsHeader}" />
                  <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsDesc}" TextWrapping="Wrap" />
                </StackPanel>
              </HeaderedContentControl.Header>
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox HorizontalAlignment="Stretch" Padding="10,5,10,5" ItemsSource="{Binding CursorSettings.SavedSets}" SelectedItem="{Binding CursorSettings.SelectedSet, Mode=TwoWay}" Visibility="{Binding CursorSettings.HasSavedSets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsEmpty}" TextWrapping="Wrap" Visibility="{Binding CursorSettings.HasNoSavedSets, Converter={StaticResource BooleanToVisibilityConverter}}" />
                  <StackPanel Grid.Column="1" Margin="8,0,0,0" Orientation="Horizontal">
                    <ui:Button Icon="Add24" Content="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsNew}" Command="{Binding CursorSettings.NewSetCommand}" />
                    <ui:Button Margin="8,0,0,0" Icon="FolderZip24" Content="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsImport}" Command="{Binding CursorSettings.ImportSetCommand}" />
                    <ui:Button Margin="8,0,0,0" Icon="FolderOpen24" Content="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsFolder}" ToolTip="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsFolderTip}" Command="{Binding CursorSettings.OpenSetsFolderCommand}" />
                  </StackPanel>
                </Grid>
                <StackPanel Margin="0,12,0,0" Visibility="{Binding CursorSettings.HasSelectedSet, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ItemsControl ItemsSource="{Binding CursorSettings.SetSlots}" ItemTemplate="{StaticResource CursorSlotRow}" />
                  <WrapPanel Margin="0,4,0,0">
                    <ui:Button Margin="0,0,8,8" Appearance="Primary" Icon="Checkmark20" Content="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsUse}" Command="{Binding CursorSettings.UseSetCommand}" />
                    <ui:Button Margin="0,0,8,8" Icon="CollectionsAdd24" Content="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsCopy}" ToolTip="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsCopyTip}" Command="{Binding CursorSettings.CopyCurrentToSetCommand}" />
                    <ui:Button Margin="0,0,8,8" Icon="Edit24" Content="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsRename}" Command="{Binding CursorSettings.RenameSetCommand}" />
                    <ui:Button Margin="0,0,8,8" Icon="ArrowExportRtl24" Content="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsExport}" Command="{Binding CursorSettings.ExportSetCommand}" />
                    <ui:Button Margin="0,0,0,8" Appearance="Danger" Icon="Delete24" Content="{x:Static resources:Strings.Menu_Mods_Page_CursorSetsDelete}" Command="{Binding CursorSettings.DeleteSetCommand}" />
                  </WrapPanel>
                </StackPanel>
              </StackPanel>
            </ui:CardExpander>

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Mods_Page_SectionInterface}" />
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Page_TopBarHeader}" Description="{x:Static resources:Strings.Menu_Mods_Page_TopBarDesc}" Visibility="{Binding ClassicTopBarVisibility}">
              <StackPanel Orientation="Horizontal">
                <ui:ProgressRing Width="20" Height="20" Margin="0,0,10,0" IsIndeterminate="True" Visibility="{Binding ClassicTopBarBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <ui:ToggleSwitch IsChecked="{Binding ClassicTopBarEnabled, Mode=TwoWay}" IsEnabled="{Binding ClassicTopBarReady}" />
              </StackPanel>
            </controls:OptionControl>
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Page_PS4Header}" Description="{x:Static resources:Strings.Menu_Mods_Page_PS4Desc}">
              <ui:ToggleSwitch IsChecked="{Binding Ps4ButtonsEnabled, Mode=TwoWay}" IsEnabled="{Binding ClassicTopBarReady}" />
            </controls:OptionControl>
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Page_HideCoreGuiHeader}" Description="{x:Static resources:Strings.Menu_Mods_Page_HideCoreGuiDesc}">
              <ui:ToggleSwitch IsChecked="{Binding ClassicTopBarHideAllCoreGui, Mode=TwoWay}" IsEnabled="{Binding ClassicTopBarCoreGuiEditable}" />
            </controls:OptionControl>

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Mods_Page_SectionSounds}" />
            <controls:OptionControl Description="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Description}" Header="{x:Static resources:Strings.Menu_Mods_Presets_OldCharacterSounds_Title}">
              <ui:ToggleSwitch IsChecked="{Binding OldCharacterSoundsTask.NewState, Mode=TwoWay}" />
            </controls:OptionControl>
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Page_DeathSoundHeader}" Description="{x:Static resources:Strings.Menu_Mods_Page_DeathSoundDesc}">
              <StackPanel>
                <ui:Button Content="{x:Static resources:Strings.Menu_Mods_Page_DeathSoundChoose}" Icon="DocumentAdd16" Command="{Binding AddCustomDeathSoundCommand}" Visibility="{Binding ChooseCustomDeathSoundVisibility, Mode=OneWay}" />
                <ui:Button Appearance="Danger" Content="{x:Static resources:Strings.Menu_Mods_Page_DeathSoundRemove}" Icon="Delete16" Command="{Binding RemoveCustomDeathSoundCommand}" Visibility="{Binding DeleteCustomDeathSoundVisibility, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Right" Visibility="{Binding CustomDeathSoundVolumeVisibility, Mode=OneWay}">
                  <TextBlock Text="{x:Static resources:Strings.Menu_Mods_Page_Volume}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                  <ComboBox MinWidth="110" ItemsSource="{Binding CustomDeathSoundVolumeOptions, Mode=OneTime}" SelectedItem="{Binding CustomDeathSoundVolume, Mode=TwoWay}" />
                </StackPanel>
              </StackPanel>
            </controls:OptionControl>

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Mods_Page_SectionAppearance}" />
            <controls:OptionControl Description="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Description}" Header="{x:Static resources:Strings.Menu_Mods_Presets_OldAvatarEditor_Title}">
              <ui:ToggleSwitch IsChecked="{Binding OldAvatarBackgroundTask.NewState, Mode=TwoWay}" />
            </controls:OptionControl>
            <controls:OptionControl Description="{x:Static resources:Strings.Menu_Mods_Presets_EmojiType_Description}" Header="{x:Static resources:Strings.Menu_Mods_Presets_EmojiType_Title}">
              <ComboBox Width="220" Margin="5,0,0,0" Padding="10,5,10,5" ItemsSource="{Binding EmojiFontTask.Selections, Mode=OneTime}" Text="{Binding EmojiFontTask.NewState, Mode=TwoWay}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Path=., Converter={StaticResource EnumNameConverter}}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ComboBox>
            </controls:OptionControl>
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Page_SkyboxHeader}" Description="{x:Static resources:Strings.Menu_Mods_Page_SkyboxDesc}">
              <StackPanel Width="360">
                <ui:CardExpander Margin="0,0,0,8" IsExpanded="False">
                  <HeaderedContentControl.Header>
                    <StackPanel>
                      <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Mods_Page_SkyboxCustom}" />
                      <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Mods_Page_SkyboxCustomDesc}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                  </HeaderedContentControl.Header>
                  <StackPanel>
                    <ui:Button HorizontalAlignment="Stretch" Content="{x:Static resources:Strings.Menu_Mods_Page_SkyboxOneImage}" Icon="ImageAdd24" Command="{Binding ChooseSingleSkyboxImageCommand}" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Mods_Page_SkyboxBack}" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxBack}" ToolTip="{Binding CustomSkyboxBack}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Back" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Mods_Page_SkyboxDown}" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxDown}" ToolTip="{Binding CustomSkyboxDown}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Down" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Mods_Page_SkyboxFront}" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxFront}" ToolTip="{Binding CustomSkyboxFront}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Front" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Mods_Page_SkyboxLeft}" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxLeft}" ToolTip="{Binding CustomSkyboxLeft}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Left" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Mods_Page_SkyboxRight}" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxRight}" ToolTip="{Binding CustomSkyboxRight}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Right" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <Grid Margin="0,6,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Mods_Page_SkyboxUp}" />
                      <ui:Button Grid.Column="1" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Content="{Binding CustomSkyboxUp}" ToolTip="{Binding CustomSkyboxUp}" Command="{Binding ChooseSkyboxFaceCommand}" CommandParameter="Up" IsEnabled="{Binding CustomSkyboxControlsEnabled}" />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0" HorizontalAlignment="Right">
                      <ui:ProgressRing Width="20" Height="20" Margin="0,0,8,0" IsIndeterminate="True" Visibility="{Binding CustomSkyboxBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ui:Button Margin="0,0,8,0" Appearance="Danger" Content="{x:Static resources:Strings.Menu_Mods_Page_SkyboxRemoveCustom}" Icon="Delete16" Command="{Binding RemoveCustomSkyboxCommand}" IsEnabled="{Binding CustomSkyboxControlsEnabled}" Visibility="{Binding HasCustomSkybox, Converter={StaticResource BooleanToVisibilityConverter}}" />
                      <ui:Button Appearance="Primary" Content="{x:Static resources:Strings.Menu_Mods_Page_SkyboxSaveUse}" Command="{Binding ApplyCustomSkyboxCommand}" IsEnabled="{Binding CustomSkyboxCanApply}" />
                    </WrapPanel>
                  </StackPanel>
                </ui:CardExpander>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" MinWidth="240" Padding="10,5,10,5" DisplayMemberPath="Name" ItemsSource="{Binding AvailableSkyboxPacks}" SelectedItem="{Binding SelectedSkyboxPack, Mode=TwoWay}" IsEnabled="{Binding SkyboxManagerReady}" />
                  <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="ArrowClockwise24" ToolTip="{x:Static resources:Strings.Menu_Mods_Page_SkyboxRefresh}" Command="{Binding RefreshSkyboxesCommand}" IsEnabled="{Binding SkyboxManagerReady}" />
                </Grid>
                <Grid Margin="0,8,0,0">
                  <ui:ToggleSwitch HorizontalAlignment="Right" IsChecked="{Binding SkyboxEnabled, Mode=TwoWay}" IsEnabled="{Binding SkyboxManagerReady}" />
                </Grid>
              </StackPanel>
            </controls:OptionControl>
            <controls:OptionControl Header="{x:Static resources:Strings.Menu_Mods_Page_FontHeader}" Description="{x:Static resources:Strings.Menu_Mods_Page_FontDesc}">
              <StackPanel Width="360">
                <Border Margin="0,0,0,8" Padding="9" MinHeight="54" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource ControlElevationBorderBrush}" Background="{DynamicResource ControlFillColorDefaultBrush}" Visibility="{Binding FontPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <TextBlock VerticalAlignment="Center" FontFamily="{Binding FontPreviewFontFamily}" FontSize="18" Text="Aa Bb Cc 123   The quick brown fox." TextWrapping="Wrap" />
                </Border>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <ComboBox Grid.Column="0" MinWidth="240" MaxDropDownHeight="360" Padding="10,5,10,5" IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True" TextSearch.TextPath="Family" DisplayMemberPath="DisplayName" ItemsSource="{Binding AvailableGoogleFonts}" SelectedItem="{Binding SelectedGoogleFont, Mode=TwoWay}" IsEnabled="{Binding FontManagerReady}" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" />
                  <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="ArrowClockwise24" ToolTip="{x:Static resources:Strings.Menu_Mods_Page_FontRefresh}" Command="{Binding RefreshGoogleFontsCommand}" IsEnabled="{Binding FontManagerReady}" />
                </Grid>
                <WrapPanel Margin="0,8,0,0" HorizontalAlignment="Right">
                  <ui:Button Margin="0,0,8,0" Content="{x:Static resources:Strings.Menu_Mods_Page_FontChooseLocal}" Icon="DocumentAdd16" Command="{Binding ChooseLocalFontCommand}" IsEnabled="{Binding FontManagerReady}" Visibility="{Binding ChooseCustomFontVisibility}" />
                  <ui:Button Margin="0,0,8,0" Content="{x:Static resources:Strings.Menu_Mods_Page_FontRemove}" Appearance="Danger" Icon="Delete16" Command="{Binding RemoveCustomFontCommand}" IsEnabled="{Binding FontManagerReady}" Visibility="{Binding DeleteCustomFontVisibility}" />
                  <ui:Button Content="{x:Static resources:Strings.Menu_Mods_Page_FontUse}" Appearance="Primary" Command="{Binding ApplyGoogleFontCommand}" IsEnabled="{Binding FontManagerCanApply}" />
                </WrapPanel>
                <Grid Margin="0,9,0,0" Visibility="{Binding HasCustomFont, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_Mods_Page_FontSize}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox MinWidth="100" ItemsSource="{Binding CustomFontScaleOptions, Mode=OneTime}" SelectedItem="{Binding CustomFontScale, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
              </StackPanel>
            </controls:OptionControl>

            <pages:ModGeneratorSection />

            <TextBlock Margin="2,24,0,0" FontSize="16" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_Mods_Page_HelpFixes}" />
            <ui:CardAction Margin="0,8,0,0" Icon="BookQuestionMark24" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/Bloxstraplabs/Bloxstrap/wiki/Adding-custom-mods">
              <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Common_Help}" FontWeight="Medium" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Mods_Help_Description}" Padding="0,0,16,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
              </StackPanel>
            </ui:CardAction>
            <ui:CardAction Margin="0,7,0,0" VerticalAlignment="Top" Icon="WindowWrench24" Command="{Binding OpenCompatSettingsCommand}" Visibility="{x:Static platform:PlatformFeatureVisibility.WindowsIntegration}">
              <StackPanel>
