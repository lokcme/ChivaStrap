                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="250" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox Name="CustomThemesListBox" Height="250" Grid.Row="0" Grid.Column="0" Margin="0,0,5,0" ItemsSource="{Binding CustomThemes, Mode=OneWay}" SelectedIndex="{Binding SelectedCustomThemeIndex, Mode=TwoWay}" SelectionChanged="CustomThemeSelection" />

                <Grid Grid.Row="1" Grid.Column="0" Margin="0,8,5,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <ui:Button Grid.Column="0" Margin="0,0,4,0" Icon="Add24" Content="{x:Static resources:Strings.Menu_Appearance_Page_NewTheme}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding AddCustomThemeCommand, Mode=OneTime}" />
                  <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="Delete24" Content="{x:Static resources:Strings.Menu_Appearance_Page_DeleteTheme}" Appearance="Danger" HorizontalAlignment="Stretch" IsEnabled="{Binding IsCustomThemeSelected, Mode=OneWay}" Command="{Binding DeleteCustomThemeCommand, Mode=OneTime}" />
                </Grid>

                <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="5,0,0,0">
                  <StackPanel.Style>
                    <Style TargetType="StackPanel">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCustomThemeSelected}" Value="False">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </StackPanel.Style>

                  <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_Page_ThemeName}" FontWeight="SemiBold" />
                  <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox Grid.Column="0" Text="{Binding SelectedCustomThemeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Icon="Save24" Content="{x:Static resources:Strings.Menu_Appearance_Page_SaveName}" Command="{Binding RenameCustomThemeCommand, Mode=OneTime}" />
                  </Grid>

                  <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Margin="0,0,4,0" Icon="DesktopEdit24" Content="{x:Static resources:Strings.Menu_Appearance_Page_OpenEditor}" Appearance="Primary" HorizontalAlignment="Stretch" Command="{Binding EditCustomThemeCommand, Mode=OneTime}" />
                    <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="Play24" Content="{x:Static resources:Strings.Menu_Appearance_Page_PreviewBtn}" HorizontalAlignment="Stretch" Command="{Binding PreviewBootstrapperCommand}" />
                  </Grid>

                  <Expander Margin="0,10,0,0" Header="{x:Static resources:Strings.Menu_Appearance_Page_MoreActions}" IsExpanded="False">
                    <Grid Margin="0,8,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <ui:Button Grid.Column="0" Margin="0,0,4,0" Icon="ImageMultiple24" Content="{x:Static resources:Strings.Menu_Appearance_Page_ViewFiles}" HorizontalAlignment="Stretch" Command="{Binding ViewCustomThemeFilesCommand, Mode=OneTime}" />
                      <ui:Button Grid.Column="1" Margin="4,0,0,0" Icon="ArrowExportRtl24" Content="{x:Static resources:Strings.Menu_Appearance_Page_Export}" HorizontalAlignment="Stretch" Command="{Binding ExportCustomThemeCommand, Mode=OneTime}" />
                    </Grid>
                  </Expander>
                </StackPanel>

                <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="5,0,0,0" Text="{x:Static resources:Strings.Menu_Appearance_Page_SelectThemeHint}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Visible" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsCustomThemeSelected}" Value="True">
                          <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </ui:CardExpander>
          </Grid>

          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <StackPanel>
                <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Appearance_Page_LauncherExtras}" />
                <TextBlock Margin="0,2,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Appearance_Page_LauncherExtrasDesc}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel IsEnabled="{Binding LauncherExtrasEnabled, Mode=OneWay}">
              <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_Page_BgHeader}" Description="{x:Static resources:Strings.Menu_Appearance_Page_BgDesc}">
                <StackPanel Orientation="Horizontal">
                  <ui:Button Content="{x:Static resources:Strings.Menu_Appearance_Page_ChooseImage}" Icon="ImageAdd24" Margin="0,0,8,0" Command="{Binding ImportBackgroundCommand}" />
                  <ui:Button Content="{x:Static resources:Strings.Menu_Appearance_Page_RemoveBgBtn}" Icon="Delete24" Appearance="Danger" Command="{Binding RemoveBackgroundCommand}" />
                </StackPanel>
              </controls:OptionControl>
              <controls:OptionControl Header="{x:Static resources:Strings.Menu_Appearance_Page_StartupSound}" Description="{x:Static resources:Strings.Menu_Appearance_Page_StartupSoundDesc}">
                <StackPanel Orientation="Horizontal">
                  <ui:Button Content="{x:Static resources:Strings.Menu_Appearance_Page_ChooseAudio}" Icon="MusicNote124" Margin="0,0,8,0" Command="{Binding ImportStartupAudioCommand}" />
                  <ui:Button Content="{x:Static resources:Strings.Menu_Appearance_Page_RemoveBgBtn}" Icon="Delete24" Appearance="Danger" Command="{Binding RemoveStartupAudioCommand}" />
                </StackPanel>
              </controls:OptionControl>
            </StackPanel>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>
      <TabItem>
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Grid24" Margin="0,0,6,0" />
            <TextBlock Text="{x:Static resources:Strings.Menu_Appearance_Page_TabIcons}" />
          </StackPanel>
        </TabItem.Header>
        <StackPanel Margin="10">
          <TextBlock Margin="0,0,0,4" FontSize="20" FontWeight="Medium" Text="{x:Static resources:Strings.Menu_Appearance_Page_TabIcons}" />
          <controls:OptionControl x:Name="IconSelector" Header="{x:Static resources:Strings.Menu_Appearance_Icon_Title}" Description="{x:Static resources:Strings.Menu_Appearance_Icon_Description}">
            <ComboBox Padding="10,5,10,5" SelectedValuePath="IconType" ItemsSource="{Binding Icons, Mode=OneWay}" SelectedValue="{Binding Icon, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Height="16" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding ImageSource, Mode=OneWay, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Path=IconType, Converter={StaticResource EnumNameConverter}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>
          <controls:OptionControl x:Name="StudioIconSelector" Header="{x:Static resources:Strings.Menu_Appearance_Page_StudioIcon}" Description="{x:Static resources:Strings.Menu_Appearance_Page_StudioIconDesc}" Visibility="{Binding StudioIconVisibility, Mode=OneWay}">
            <ComboBox Padding="10,5,10,5" SelectedValuePath="IconType" ItemsSource="{Binding Icons, Mode=OneWay}" SelectedValue="{Binding StudioIcon, Mode=TwoWay}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Height="16" RenderOptions.BitmapScalingMode="HighQuality" Source="{Binding ImageSource, Mode=OneWay, TargetNullValue={x:Null}, FallbackValue={x:Null}}" />
                    <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding Path=IconType, Converter={StaticResource EnumNameConverter}}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ComboBox>
          </controls:OptionControl>
          <ui:CardExpander Margin="0,8,0,0" IsExpanded="False">
            <HeaderedContentControl.Header>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <TextBlock FontSize="14" Text="{x:Static resources:Strings.Menu_Appearance_Page_Customization}" />
                  <TextBlock FontSize="12" Text="{x:Static resources:Strings.Menu_Appearance_Customisation_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                </StackPanel>
              </Grid>
            </HeaderedContentControl.Header>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static resources:Strings.Menu_Appearance_CustomisationTitle_Title}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <ui:TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title, Mode=TwoWay}" />
              <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Appearance_CustomisationTitle_Description}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" Text="{x:Static resources:Strings.Menu_Appearance_CustomisationIcon_Title}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              <Grid Row="2" Column="1" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox Grid.Column="0" Margin="0,0,4,0" Text="{Binding CustomIconLocation, Mode=TwoWay}" />
                <ui:Button Grid.Column="1" Margin="4,0,0,0" Height="35" Icon="Folder24" Content="{x:Static resources:Strings.Common_Browse}" Command="{Binding BrowseCustomIconLocationCommand}" />
              </Grid>
              <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,0,0" FontSize="12" Text="{x:Static resources:Strings.Menu_Appearance_CustomisationIcon_Description}" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
          </ui:CardExpander>
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</ui:UiPage>
