<base:WpfUiWindow x:Class="Chivas.UI.Elements.Dialogs.LaunchMenuDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:base="clr-namespace:Chivas.UI.Elements.Base" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Chivas.UI.Elements.Dialogs" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Chivas.UI.ViewModels" xmlns:resources="clr-namespace:Chivas.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="Chivas" Width="740" MinWidth="0" MinHeight="0" BorderBrush="{DynamicResource GlassAccentBrush}" BorderThickness="1,1,1,1" ExtendsContentIntoTitleBar="True" ResizeMode="NoResize" SizeToContent="Height" AllowsTransparency="True" WindowBackdropType="Aero" WindowStyle="None" WindowStartupLocation="CenterScreen" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
  <FrameworkElement.Resources>
    <SolidColorBrush x:Key="GlassAccentBrush" Color="{DynamicResource GlassAccentColor}" />
    <SolidColorBrush x:Key="LaunchGlassCardBrush" Color="{DynamicResource WindowBackgroundColorSecondary}" />
    <SolidColorBrush x:Key="LaunchGlassStrokeBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
  </FrameworkElement.Resources>
  <Grid>
    <Panel.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1" SpreadMethod="Pad">
        <GradientStop Offset="0.00" Color="{DynamicResource WindowBackgroundColorPrimary}" />
        <GradientStop Offset="0.55" Color="{DynamicResource WindowBackgroundColorSecondary}" />
        <GradientStop Offset="1.00" Color="{DynamicResource WindowBackgroundColorTertiary}" />
      </LinearGradientBrush>
    </Panel.Background>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <ui:TitleBar Title="Chivas" Grid.Row="0" Padding="8" CanMaximize="False" Icon="pack://application:,,,/Chivas.png" KeyboardNavigation.TabNavigation="None" ShowMaximize="False" ShowMinimize="True" />
    <Grid Name="grid" Grid.Row="1" Margin="28,8,28,22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel.Triggers>
          <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.25" />
                <DoubleAnimation Storyboard.TargetName="HeroLogoScale" Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.25" />
                <DoubleAnimation Storyboard.TargetName="HeroLogoScale" Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.25" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
          <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="LogoGlow" Storyboard.TargetProperty="Opacity" To="0.45" Duration="0:0:0.3" />
                <DoubleAnimation Storyboard.TargetName="HeroLogoScale" Storyboard.TargetProperty="ScaleX" To="1.0" Duration="0:0:0.3" />
                <DoubleAnimation Storyboard.TargetName="HeroLogoScale" Storyboard.TargetProperty="ScaleY" To="1.0" Duration="0:0:0.3" />
              </Storyboard>
            </BeginStoryboard>
          </EventTrigger>
        </StackPanel.Triggers>
        <Grid HorizontalAlignment="Center" Margin="0,0,0,14">
          <Ellipse x:Name="LogoGlow" Width="150" Height="150" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.45">
            <Ellipse.Fill>
              <RadialGradientBrush GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                <GradientStop Offset="0.0" Color="{DynamicResource GlassAccentColor}" />
                <GradientStop Offset="0.6" Color="{DynamicResource WindowBackgroundColorSecondary}" />
                <GradientStop Offset="1.0" Color="#00000000" />
              </RadialGradientBrush>
            </Ellipse.Fill>
          </Ellipse>
          <Image x:Name="HeroLogo" Width="104" Height="104" HorizontalAlignment="Center" VerticalAlignment="Center" Source="pack://application:,,,/Chivas.png" RenderOptions.BitmapScalingMode="HighQuality">
            <Image.RenderTransform>
              <ScaleTransform x:Name="HeroLogoScale" CenterX="52" CenterY="52" ScaleX="1" ScaleY="1" />
            </Image.RenderTransform>
          </Image>
        </Grid>
        <TextBlock Text="Chivas" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <ui:Hyperlink Margin="0,14,0,0" HorizontalAlignment="Center" Icon="QuestionCircle48" Content="{x:Static resources:Strings.About_Title}" Command="{Binding LaunchAboutCommand, Mode=OneTime}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
        <ui:CardAction TabIndex="0" Padding="16,18,15,18" Background="{DynamicResource LaunchGlassCardBrush}" BorderBrush="{DynamicResource LaunchGlassStrokeBrush}" Command="{Binding LaunchRobloxCommand, Mode=OneTime}">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Width="28" Height="28" Margin="0,0,12,0" VerticalAlignment="Center" Source="pack://application:,,,/Resources/RobloxPlayerIcon.png" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Text="{x:Static resources:Strings.LaunchMenu_LaunchRoblox}" />
          </StackPanel>
        </ui:CardAction>
        <Grid Margin="0,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <ui:CardAction Grid.Column="0" Margin="0,0,5,0" Padding="15,14,14,13" Background="{DynamicResource LaunchGlassCardBrush}" BorderBrush="{DynamicResource LaunchGlassStrokeBrush}" IsChevronVisible="False" Icon="Settings28" TabIndex="1" Command="{Binding LaunchSettingsCommand, Mode=OneTime}">
            <TextBlock FontSize="14" TextTrimming="None" Text="{x:Static resources:Strings.Menu_Sidebar_Settings}" />
          </ui:CardAction>
          <ui:CardAction Grid.Column="1" Margin="5,0,0,0" Padding="15,14,14,13" Background="{DynamicResource LaunchGlassCardBrush}" BorderBrush="{DynamicResource LaunchGlassStrokeBrush}" IsChevronVisible="False" TabIndex="2" Command="{Binding LaunchRobloxStudioCommand, Mode=OneTime}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" Source="pack://application:,,,/Resources/RobloxStudioIcon.png" RenderOptions.BitmapScalingMode="HighQuality" />
              <TextBlock FontSize="14" TextTrimming="None" VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_LaunchMenu_Studio}" />
            </StackPanel>
          </ui:CardAction>
        </Grid>
        <ui:CardAction Margin="0,10,0,0" Padding="15,14,15,14" Background="{DynamicResource LaunchGlassCardBrush}" BorderBrush="{DynamicResource LaunchGlassStrokeBrush}" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/lokcme/ChivaStrap" IconFilled="False" TabIndex="3">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Path Width="22" Height="22" Margin="0,0,12,0" VerticalAlignment="Center" Fill="White" Stretch="Uniform" Data="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock FontSize="14" Text="GitHub" />
              <TextBlock Margin="0,2,0,0" Padding="0,0,16,0" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_LaunchMenu_GitHubDesc}" />
            </StackPanel>
          </StackPanel>
        </ui:CardAction>
        <TextBlock Margin="2,12,0,0" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="{x:Static resources:Strings.Menu_LaunchMenu_Hint}" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="2" Height="3" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" CornerRadius="0,0,6,6">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
          <GradientStop Offset="0.0" Color="{DynamicResource GlassAccentColor}" />
          <GradientStop Offset="0.5" Color="{DynamicResource GlassAccentColor}" />
          <GradientStop Offset="1.0" Color="#FFFFFF" />
        </LinearGradientBrush>
      </Border.Background>
    </Border>
  </Grid>
</base:WpfUiWindow>
