<ui:UiPage x:Class="Chivas.UI.Elements.Installer.Pages.ChannelPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Chivas.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:Chivas.UI.Elements.Installer.Pages" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:resources="clr-namespace:Chivas.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="ChannelPage" Scrollable="True" Loaded="UiPage_Loaded" Unloaded="UiPage_Unloaded">
  <StackPanel Margin="0,0,14,14">
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="{x:Static resources:Strings.Installer_Channel_DownloadServer_Title}" TextWrapping="Wrap" />
    <TextBlock Margin="0,4,0,0" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{x:Static resources:Strings.Installer_Channel_DownloadServer_Description}" />
        <controls:OptionControl Margin="0,0,0,4" Header="{x:Static resources:Strings.Installer_Channel_DownloadServer_Option}" Description="{x:Static resources:Strings.Installer_Channel_DownloadServer_OptionDescription}">
      <ComboBox MinWidth="300" Height="35" Padding="10,5,10,5" VerticalContentAlignment="Center" DisplayMemberPath="Display" ItemsSource="{Binding Mirrors}" SelectedItem="{Binding SelectedMirror, Mode=TwoWay}" />
    </controls:OptionControl>

    <TextBlock Margin="0,24,0,0" FontSize="20" FontWeight="SemiBold" Text="{x:Static resources:Strings.Installer_Channel_Title}" TextWrapping="Wrap" />
    <TextBlock Margin="0,4,0,0" FontSize="14" LineHeight="20" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="{x:Static resources:Strings.Installer_Channel_ChannelSection_Description}" />
    <controls:OptionControl Margin="0,0,0,4" Header="{x:Static resources:Strings.Installer_Channel_PreferredChannel}" Description="{x:Static resources:Strings.Installer_Channel_PreferredChannelDescription}">
      <ui:TextBox MinWidth="300" Height="35" VerticalContentAlignment="Center" PlaceholderText="Production" Text="{Binding Channel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
    </controls:OptionControl>
  </StackPanel>
</ui:UiPage>
