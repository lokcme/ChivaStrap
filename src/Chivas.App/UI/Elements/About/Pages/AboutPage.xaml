<ui:UiPage x:Class="Chivas.UI.Elements.About.Pages.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:models="clr-namespace:Chivas.UI.ViewModels" xmlns:resources="clr-namespace:Chivas.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Chivas.Utility" Title="AboutPage" Scrollable="True">
  <ui:UiPage.Resources>
    <Color x:Key="AboutRedGlow">#8E1F16</Color>
    <SolidColorBrush x:Key="AboutAccentBrush" Color="#FF7F6E" />
    <SolidColorBrush x:Key="AboutRingBrush" Color="#D43A2A" />
    <Style x:Key="AboutGroupHeader" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="0,22,0,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>
    <Style x:Key="AboutCard" TargetType="{x:Type Border}">
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    </Style>
    <Style x:Key="AboutTile" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="48" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="#20000000" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>
    <Style x:Key="AboutLinkCard" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="Padding" Value="16" />
      <Setter Property="Margin" Value="6,0,6,12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </ui:UiPage.Resources>
  <StackPanel Margin="0,0,18,18">
    <Border Style="{StaticResource AboutCard}" ClipToBounds="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>
        <Image Grid.Column="0" Width="104" Height="104" Margin="22,22,0,22" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Chivas.png" />
        <StackPanel Grid.Column="1" Margin="20,0,12,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontSize="34" FontWeight="SemiBold" Text="Chivas" />
            <Border Margin="12,0,0,0" Padding="10,3" VerticalAlignment="Center" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
              <TextBlock FontSize="13" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding VersionTag, Mode=OneTime}" />
            </Border>
          </StackPanel>
          <TextBlock Margin="0,6,0,0" FontSize="14" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_Tagline}" TextWrapping="Wrap" />
        </StackPanel>
        <Grid Grid.Column="2">
          <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Offset="0" Color="#00000000" />
              <GradientStop Offset="1" Color="{StaticResource AboutRedGlow}" />
            </LinearGradientBrush>
          </Grid.Background>
          <Image Width="150" Height="150" Opacity="0.28" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Source="pack://application:,,,/Chivas.png" />
        </Grid>
      </Grid>
    </Border>

    <TextBlock Style="{StaticResource AboutGroupHeader}" Text="{x:Static resources:Strings.Menu_About_LinksHeader}" />
    <UniformGrid Margin="-6,12,-6,0" Columns="2">
      <Button Style="{StaticResource AboutLinkCard}" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/lokcme/ChivaStrap">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource AboutTile}">
            <ui:SymbolIcon Symbol="Code24" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_About_LinkGithubTitle}" />
          </StackPanel>
          <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight24" FontSize="18" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
        </Grid>
      </Button>
      <Button Style="{StaticResource AboutLinkCard}" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://chivababy.netlify.app/strap">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource AboutTile}">
            <ui:SymbolIcon Symbol="BookQuestionMark24" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_About_LinkHelpTitle}" />
            <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_LinkHelpDesc}" />
          </StackPanel>
          <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight24" FontSize="18" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
        </Grid>
      </Button>
      <Button Style="{StaticResource AboutLinkCard}" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://chivababy.netlify.app/support">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource AboutTile}">
            <ui:SymbolIcon Symbol="BookExclamationMark24" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_About_LinkReportTitle}" />
            <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_LinkReportDesc}" />
          </StackPanel>
          <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight24" FontSize="18" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
        </Grid>
      </Button>
      <Button Style="{StaticResource AboutLinkCard}" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://discord.gg/xna6HKTG6T">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Style="{StaticResource AboutTile}">
            <ui:SymbolIcon Symbol="Chat48" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_About_LinkDiscordTitle}" />
            <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_LinkDiscordDesc}" />
          </StackPanel>
          <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight24" FontSize="18" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
        </Grid>
      </Button>
    </UniformGrid>

    <Grid Margin="0,10,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="11*" />
        <ColumnDefinition Width="9*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,6,0">
        <TextBlock Style="{StaticResource AboutGroupHeader}" Margin="0" Text="{x:Static resources:Strings.Menu_About_CreatorHeader}" />
        <Border Style="{StaticResource AboutCard}" Margin="0,12,0,0" Padding="18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="88" Height="88" CornerRadius="44" BorderThickness="2" BorderBrush="{StaticResource AboutRingBrush}">
              <Border Width="84" Height="84" CornerRadius="42" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Clip>
                  <EllipseGeometry Center="42,42" RadiusX="42" RadiusY="42" />
                </Border.Clip>
                <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="https://github.com/lokcme.png" />
              </Border>
            </Border>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
              <TextBlock FontSize="18" FontWeight="SemiBold" Text="lokcme" />
              <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_CreatorRole}" />
              <ui:Button Margin="0,10,0,0" HorizontalAlignment="Left" Appearance="Secondary" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/lokcme">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock VerticalAlignment="Center" Text="{x:Static resources:Strings.Menu_About_ViewProfile}" />
                  <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="↗" />
                </StackPanel>
              </ui:Button>
            </StackPanel>
          </Grid>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="6,0,0,0">
        <TextBlock Style="{StaticResource AboutGroupHeader}" Margin="0" Text="{x:Static resources:Strings.Menu_About_AppInfoHeader}" />
        <UniformGrid Margin="0,12,0,0" Columns="2">
          <Border Style="{StaticResource AboutCard}" Margin="0,0,6,0" Padding="14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Box24" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
                <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_VersionLabel}" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0" FontSize="22" FontWeight="SemiBold" Text="{Binding VersionNumber, Mode=OneTime}" />
            </StackPanel>
          </Border>
          <Border Style="{StaticResource AboutCard}" Margin="6,0,0,0" Padding="14">
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="History24" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
                <TextBlock Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_LastUpdatedLabel}" />
              </StackPanel>
              <TextBlock Margin="0,10,0,0" FontSize="19" FontWeight="SemiBold" Text="{Binding BuildDate, Mode=OneTime}" />
              <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding BuildTime, Mode=OneTime}" />
            </StackPanel>
          </Border>
        </UniformGrid>
      </StackPanel>
    </Grid>

    <Button Style="{StaticResource AboutLinkCard}" Margin="0,12,0,0" Click="ThirdParty_Click">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource AboutTile}">
          <ui:SymbolIcon Symbol="Info24" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
        </Border>
        <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
          <TextBlock FontSize="15" FontWeight="SemiBold" Text="{x:Static resources:Strings.Menu_About_ThirdPartyTitle}" />
          <TextBlock Margin="0,2,0,0" FontSize="13" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{x:Static resources:Strings.Menu_About_ThirdPartyDesc}" />
        </StackPanel>
        <ui:SymbolIcon Grid.Column="2" Symbol="ArrowRight24" FontSize="18" VerticalAlignment="Center" Foreground="{StaticResource AboutAccentBrush}" />
      </Grid>
    </Button>

    <TextBlock Margin="0,22,0,0" FontSize="13" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
      <Run Text="♡  " /><Run Text="{x:Static resources:Strings.Menu_About_MadeWithPrefix}" /><Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/lokcme" Foreground="{StaticResource AboutAccentBrush}"><Run Text="lokcme" /></Hyperlink><Run Text="{x:Static resources:Strings.Menu_About_MadeWithSuffix}" />
    </TextBlock>
  </StackPanel>
</ui:UiPage>
