<ui:UiPage x:Class="Chivas.UI.Elements.About.Pages.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Chivas.UI.Elements.Controls" xmlns:models="clr-namespace:Chivas.UI.ViewModels" xmlns:resources="clr-namespace:Chivas.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:util="clr-namespace:Chivas.Utility" Title="AboutPage" Scrollable="True" KeyDown="UiPage_KeyDown">
  <ui:UiPage.Resources>
    <Storyboard x:Key="EggStoryboard">
      <DoubleAnimation Storyboard.TargetName="Image1" Storyboard.TargetProperty="Opacity" From="1.0" To="0.0" Duration="0:0:3" />
      <DoubleAnimation Storyboard.TargetName="Image2" Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:3" />
    </Storyboard>
    <Style x:Key="AboutSectionTitle" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="0,24,0,0" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="AboutSectionSubtitle" TargetType="{x:Type TextBlock}">
      <Setter Property="Margin" Value="0,2,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <BitmapImage x:Key="ErikImage" UriSource="pack://application:,,,/Resources/Erik.png" DecodePixelHeight="176" CacheOption="OnLoad" CreateOptions="IgnoreColorProfile" />
    <Style x:Key="ErikButton" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="SnapsToDevicePixels" Value="True" />
      <Setter Property="RenderTransformOrigin" Value="0.5,1" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="Transparent">
              <ContentPresenter />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.88" />
        </Trigger>
      </Style.Triggers>
    </Style>    <Style x:Key="ContributorAvatar" TargetType="{x:Type Border}">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
      <Setter Property="Clip">
        <Setter.Value>
          <RectangleGeometry RadiusX="22" RadiusY="22" Rect="0,0,44,44" />
        </Setter.Value>
      </Setter>
    </Style>
  </ui:UiPage.Resources>
  <StackPanel Margin="0,0,18,18">
    <ui:Card Padding="20,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Width="64" Height="64" VerticalAlignment="Center">
          <Image x:Name="Image1" Source="pack://application:,,,/Chivas.png" RenderOptions.BitmapScalingMode="HighQuality" />
          <Image x:Name="Image2" Source="pack://application:,,,/Resources/BootstrapperStyles/ByfronDialog/Matt.png" RenderOptions.BitmapScalingMode="HighQuality" Opacity="0" />
        </Grid>
        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold" Text="Chivas" />
            <Border Margin="10,2,0,0" Padding="8,2" VerticalAlignment="Center" CornerRadius="1" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1">
              <TextBlock FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Version, Mode=OneTime}" />
            </Border>
          </StackPanel>
          <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="A simple yet advanced Bloxstrap fork." TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="2" Margin="24,0,6,0" VerticalAlignment="Bottom" Style="{StaticResource ErikButton}" ToolTip="Thank you, Erik" Click="ErikButton_Click">
          <Image Height="74" Stretch="Uniform" Source="{StaticResource ErikImage}" RenderOptions.BitmapScalingMode="HighQuality" />
        </Button>
      </Grid>
    </ui:Card>
    <UniformGrid Margin="-4,8,-4,0" Columns="2">
      <ui:Anchor Margin="4" HorizontalAlignment="Stretch" Content="{x:Static resources:Strings.Menu_About_GithubRepository}" Icon="Code24" NavigateUri="https://github.com/lokcme/ChivaStrap" />
      <ui:Anchor Margin="4" HorizontalAlignment="Stretch" Content="{x:Static resources:Strings.Menu_About_HelpInformation}" Icon="BookQuestionMark24" NavigateUri="https://chivatyys.netlify.app/" />
      <ui:Anchor Margin="4" HorizontalAlignment="Stretch" Content="{x:Static resources:Strings.Menu_About_ReportIssue}" Icon="BookExclamationMark24" NavigateUri="https://github.com/lokcme/ChivaStrap/issues" />
      <ui:Anchor Margin="4" HorizontalAlignment="Stretch" Content="{x:Static resources:Strings.Menu_About_DiscordServer}" Icon="Chat48" NavigateUri="https://discord.gg/xna6HKTG6T" />
    </UniformGrid>
    <TextBlock Style="{StaticResource AboutSectionTitle}" Text="Owner" />
    <TextBlock Style="{StaticResource AboutSectionSubtitle}" Text="Creador y dueño de ChivaStrap." />
    <UniformGrid Margin="-4,6,-4,0" Columns="2">
      <UniformGrid.Resources>
        <Style TargetType="{x:Type ui:Card}" BasedOn="{StaticResource {x:Type ui:Card}}">
          <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
      </UniformGrid.Resources>
      <ui:Card Margin="4" Padding="12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Border Style="{StaticResource ContributorAvatar}">
            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" util:DynamicRenderSystem.LazyImageSource="https://github.com/lokcme.png" />
          </Border>
          <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock FontSize="15" FontWeight="SemiBold" Text="lokcme" />
            <TextBlock Margin="0,1,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="Dueño de ChivaStrap." TextWrapping="Wrap" />
          </StackPanel>
        </Grid>
      </ui:Card>
    </UniformGrid>
    <StackPanel Visibility="{Binding BuildInformationVisibility, Mode=OneTime}">
      <TextBlock Style="{StaticResource AboutSectionTitle}" Text="Build Information" />
      <ui:Card Margin="0,10,0,0" Padding="16,10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,4,20,4" FontSize="14" FontWeight="Medium" Text="Updated" />
          <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding BuildTimestamp, Mode=OneTime}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,4,20,4" FontSize="14" FontWeight="Medium" Text="Version" />
          <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding Version, Mode=OneTime}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,4,20,4" FontSize="14" FontWeight="Medium" Text="Commit Hash" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}" />
          <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,0,4" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding BuildCommitVisibility, Mode=OneTime}">
            <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding BuildCommitHashUrl, Mode=OneTime}" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
              <TextBlock Text="{Binding CommitHash, Mode=OneTime}" />
            </Hyperlink>
          </TextBlock>
        </Grid>
      </ui:Card>
    </StackPanel>
    <TextBlock Style="{StaticResource AboutSectionTitle}" Text="Third Party Notices" />
    <ui:Card Margin="0,10,0,0" Padding="16,12">
      <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="This software contains source code provided by NVIDIA Corporation. Frame generation uses the NVIDIA Optical Flow SDK FRUC library on supported NVIDIA GPUs." TextWrapping="Wrap" />
    </ui:Card>
    <ui:Card Margin="0,10,0,0" Padding="16,12">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Medium" Text="Old Roblox TopBar UI" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="The classic topbar option rebuilds two community mods. The 2014 to 2015 topbar and game menu artwork and behaviour come from &quot;2014-2015 Topbar and Menu (Improvised GUI)&quot; by HockuTM. Hiding the modern topbar uses &quot;NoGuiRBX, Hide TopBar!&quot; by Einshine. Both are used with thanks under their Creative Commons BY NC ND 4.0 terms, their files are downloaded straight from GameBanana rather than bundled, and neither author is affiliated with Chivas." />
        <TextBlock Margin="0,6,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/mods/711267" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="2014-2015 Topbar and Menu by HockuTM" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,2,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/mods/620117" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="NoGuiRBX, Hide TopBar! by Einshine" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </ui:Card>
    <ui:Card Margin="0,10,0,0" Padding="16,12">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Medium" Text="Community Mods" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="Community Mods lists Roblox submissions from GameBanana and Kliko's Mods, maintained by TheKliko for Kliko's modloader. Chivas is not affiliated with or endorsed by either. All mods, images and descriptions belong to their authors, who are credited on every listing. Chivas only reads their public data and never uploads anything on your behalf." />
        <TextBlock Margin="0,6,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/games/2879" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="gamebanana.com/games/2879" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,2,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/klikos-modloader/marketplace" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="github.com/klikos-modloader/marketplace" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </ui:Card>
  </StackPanel>
</ui:UiPage>
