<ui:UiPage x:Class="Chivas.UI.Elements.About.Pages.LicensesPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Chivas.UI.Elements.Controls" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:data="clr-namespace:Chivas.Models" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:models="clr-namespace:Chivas.UI.ViewModels" xmlns:resources="clr-namespace:Chivas.Resources" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" Title="AboutPage" Scrollable="True" xmlns:pages="clr-namespace:Chivas.UI.Elements.About.Pages">
  <ui:UiPage.Resources>
    <DataTemplate x:Key="LicenseCardTemplate">
      <ui:CardAction Margin="0,0,8,8" VerticalAlignment="Stretch" Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="{Binding Url}">
        <StackPanel>
          <TextBlock FontSize="14" TextWrapping="Wrap" Text="{Binding Name}" />
          <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="{Binding License}" />
        </StackPanel>
      </ui:CardAction>
    </DataTemplate>
  </ui:UiPage.Resources>
  <StackPanel Margin="0,0,14,14">
    <TextBlock Margin="0,0,0,16" FontSize="24" FontWeight="Medium" Text="{x:Static resources:Strings.Menu_About_Licenses}" />
    <ItemsControl ItemTemplate="{StaticResource LicenseCardTemplate}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <data:LicenseEntry Name="Chivas" Url="https://github.com/lokcme/ChivaStrap/blob/main/LICENSE.CHIVAS" License="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
      <data:LicenseEntry Name="WPF-UI" Url="https://github.com/lepoco/wpfui/blob/main/LICENSE" License="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
      <data:LicenseEntry Name="ShellLink" Url="https://github.com/securifybv/ShellLink/blob/master/LICENSE.txt" License="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
      <data:LicenseEntry Name="DiscordRPC" Url="https://github.com/Lachee/discord-rpc-csharp/blob/master/LICENSE" License="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
      <data:LicenseEntry Name="Roblox Studio Mod Manager" Url="https://github.com/MaximumADHD/Roblox-Studio-Mod-Manager/blob/main/LICENSE" License="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
      <data:LicenseEntry Name="SharpZipLib" Url="https://github.com/icsharpcode/SharpZipLib/blob/master/LICENSE.txt" License="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
      <data:LicenseEntry Name="Markdig" Url="https://github.com/xoofx/markdig/blob/main/license.txt" License="{x:Static resources:Strings.Menu_About_Licenses_BSD2}" />
      <data:LicenseEntry Name="AvalonEdit" Url="https://github.com/icsharpcode/AvalonEdit/blob/master/LICENSE" License="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
      <data:LicenseEntry Name="SharpDX/SharpDXGI" Url="https://github.com/sharpdx/SharpDX/blob/master/LICENSE" License="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
      <data:LicenseEntry Name="Nvidia Profile Inspector" Url="https://github.com/Orbmu2k/nvidiaProfileInspector/blob/master/LICENSE.txt" License="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
      <data:LicenseEntry Name="NewtonsoftJSON" Url="https://github.com/JamesNK/Newtonsoft.Json/blob/master/LICENSE.md" License="{x:Static resources:Strings.Menu_About_Licenses_MIT}" />
	  <data:LicenseEntry Name="Bibata Cursor" Url="https://github.com/ful1e5/Bibata_Cursor/blob/v2.0.7/LICENSE" License="GPL 3.0" />
      <data:LicenseEntry Name="Twemoji Mozilla" Url="https://github.com/mozilla/twemoji-colr/blob/master/LICENSE.md" License="CC BY 4.0" />
    </ItemsControl>
    <TextBlock Margin="0,20,0,0" FontSize="16" FontWeight="Medium" Text="Third-Party Notices" />
    <ui:Card Margin="0,10,0,0" Padding="16,12">
      <TextBlock Foreground="{DynamicResource TextFillColorTertiaryBrush}" Text="This software contains source code provided by NVIDIA Corporation. Frame generation uses the NVIDIA Optical Flow SDK FRUC library on supported NVIDIA GPUs." TextWrapping="Wrap" />
    </ui:Card>
    <ui:Card Margin="0,10,0,0" Padding="16,12">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Medium" Text="Old Roblox TopBar UI" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="The classic topbar option rebuilds two community mods. The 2014 to 2015 topbar and game menu artwork and behaviour come from &quot;2014-2015 Topbar and Menu (Improvised GUI)&quot; by HockuTM. Hiding the modern topbar uses &quot;NoGuiRBX, Hide TopBar!&quot; by Einshine. Both are used with thanks under their Creative Commons BY NC ND 4.0 terms, their files are downloaded straight from GameBanana rather than bundled, and neither author is affiliated with Chivas." />
        <TextBlock Margin="0,6,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/mods/711267" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="2014-2015 Topbar and Menu by HockuTM" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,2,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/mods/620117" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="NoGuiRBX, Hide TopBar! by Einshine" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </ui:Card>
    <ui:Card Margin="0,10,0,0" Padding="16,12">
      <StackPanel>
        <TextBlock FontSize="14" FontWeight="Medium" Text="Community Mods" />
        <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" Text="Community Mods lists Roblox submissions from GameBanana and the official ChivaStrap mods repository. All mods, images and descriptions belong to their authors, who are credited on every listing. Chivas only reads their public data and never uploads anything on your behalf." />
        <TextBlock Margin="0,6,0,0">
          <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://gamebanana.com/games/2879" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
            <TextBlock Text="gamebanana.com/games/2879" />
          </Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,2,0,0">
            <Hyperlink Command="models:GlobalViewModel.OpenWebpageCommand" CommandParameter="https://github.com/lokcme/ChivaStrapMods" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
              <TextBlock Text="github.com/lokcme/ChivaStrapMods" />
          </Hyperlink>
        </TextBlock>
      </StackPanel>
    </ui:Card>
  </StackPanel>
</ui:UiPage>
