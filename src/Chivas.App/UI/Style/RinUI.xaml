  <SolidColorBrush x:Key="SystemFillColorNeutralBrush" Color="{DynamicResource SystemFillColorNeutral}" />
  <LinearGradientBrush x:Key="ControlElevationBorderBrush" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
    <LinearGradientBrush.GradientStops>
      <GradientStop Offset="0.33" Color="{DynamicResource ControlStrokeColorSecondary}" />
      <GradientStop Offset="1.0" Color="{DynamicResource ControlStrokeColorDefault}" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="CircleElevationBorderBrush" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="0,1">
    <LinearGradientBrush.GradientStops>
      <GradientStop Offset="0.5" Color="{DynamicResource ControlStrokeColorSecondary}" />
      <GradientStop Offset="1.0" Color="{DynamicResource ControlStrokeColorDefault}" />
    </LinearGradientBrush.GradientStops>
  </LinearGradientBrush>
  <SolidColorBrush x:Key="GlassAccentBrush" Color="{DynamicResource GlassAccentColor}" />
  <SolidColorBrush x:Key="GlassAccentSoftBrush" Color="{DynamicResource GlassAccentColor}" Opacity="0.2" />
  <SolidColorBrush x:Key="GlassControlStrokeBrush" Color="{DynamicResource ControlStrokeColorDefault}" />
  <SolidColorBrush x:Key="GlassInputSurfaceBrush" Color="{DynamicResource ControlFillColorInputActive}" />
  <LinearGradientBrush x:Key="GlassCardSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#22FFFFFF" />
    <GradientStop Offset="0.16" Color="{DynamicResource WindowBackgroundColorSecondary}" />
    <GradientStop Offset="0.72" Color="{DynamicResource WindowBackgroundColorPrimary}" />
    <GradientStop Offset="1" Color="{DynamicResource WindowBackgroundColorSecondary}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassButtonSurfaceBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#20FFFFFF" />
    <GradientStop Offset="0.24" Color="{DynamicResource WindowBackgroundColorSecondary}" />
    <GradientStop Offset="1" Color="{DynamicResource WindowBackgroundColorPrimary}" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassButtonHoverBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#38FFFFFF" />
    <GradientStop Offset="0.24" Color="{DynamicResource WindowBackgroundColorSecondary}" />
    <GradientStop Offset="1" Color="{DynamicResource WindowBackgroundColorPrimary}" />
  </LinearGradientBrush>
  <Style TargetType="{x:Type Button}" BasedOn="{StaticResource DefaultButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource GlassButtonSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
    <Setter Property="Padding" Value="12,7" />
  </Style>
  <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource DefaultToggleButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource GlassButtonSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
  </Style>
  <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource DefaultUiButtonStyle}">
    <Setter Property="Background" Value="{DynamicResource GlassButtonSurfaceBrush}" />
    <Setter Property="MouseOverBackground" Value="{DynamicResource GlassButtonHoverBrush}" />
    <Setter Property="PressedBackground" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="MouseOverBorderBrush" Value="{DynamicResource GlassAccentSoftBrush}" />
    <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
  </Style>
  <Style TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource DefaultUiToggleSwitchStyle}">
    <Setter Property="Background" Value="{DynamicResource GlassAccentBrush}" />
  </Style>
  <Style TargetType="{x:Type ui:CardAction}" BasedOn="{StaticResource DefaultUiCardActionStyle}">
    <Setter Property="Background" Value="{DynamicResource GlassCardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="Border.CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="18,15" />
  </Style>
  <Style TargetType="{x:Type ui:CardControl}" BasedOn="{StaticResource DefaultUiCardControlStyle}">
    <Setter Property="Background" Value="{DynamicResource GlassCardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="Border.CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="18,15" />
  </Style>
  <Style TargetType="{x:Type ui:CardExpander}" BasedOn="{StaticResource DefaultUiCardExpanderStyle}">
    <Setter Property="Background" Value="{DynamicResource GlassCardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="Border.CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="18,15" />
  </Style>
  <Style x:Key="GlassInfoBarBaseStyle" TargetType="{x:Type ui:InfoBar}" BasedOn="{StaticResource {x:Type ui:InfoBar}}">
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="Border.CornerRadius" Value="{DynamicResource OverlayCornerRadius}" />
    <Setter Property="Padding" Value="14,12" />
  </Style>
  <Style TargetType="{x:Type ui:InfoBar}" BasedOn="{StaticResource GlassInfoBarBaseStyle}" />
  <Style x:Key="GlassSnackbarBaseStyle" TargetType="{x:Type ui:Snackbar}" BasedOn="{StaticResource {x:Type ui:Snackbar}}">
    <Setter Property="Background" Value="{DynamicResource GlassCardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="MessageForeground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="IconForeground" Value="{DynamicResource GlassAccentBrush}" />
    <Style.Triggers>
      <Trigger Property="Appearance" Value="Secondary">
        <Setter Property="Background" Value="{DynamicResource GlassCardSurfaceBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ui:Snackbar}" BasedOn="{StaticResource GlassSnackbarBaseStyle}" />
  <Style TargetType="{x:Type ui:Flyout}" BasedOn="{StaticResource DefaultFlyoutStyle}">
    <Setter Property="Background" Value="{DynamicResource GlassCardSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource DefaultTextBoxStyle}">
    <Setter Property="Background" Value="{DynamicResource GlassInputSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
  </Style>
  <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource DefaultComboBoxStyle}">
    <Setter Property="Background" Value="{DynamicResource GlassInputSurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
  </Style>
  <Style TargetType="{x:Type DataGrid}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
    <Setter Property="RowBackground" Value="Transparent" />
    <Setter Property="AlternatingRowBackground" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
    <Setter Property="GridLinesVisibility" Value="Horizontal" />
  </Style>
  <Style TargetType="{x:Type DataGridColumnHeader}">
    <Setter Property="Background" Value="{DynamicResource GlassCardSurfaceBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>
  <Style TargetType="{x:Type DataGridCell}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="9,6" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource GlassAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>
  <Style TargetType="{x:Type ListBoxItem}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource GlassAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style TargetType="{x:Type ListView}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource GlassControlStrokeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>
  <Style TargetType="{x:Type ListViewItem}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource GlassHighlightBrush}" />
      </Trigger>
      <Trigger Property="IsSelected" Value="True">
        <Setter Property="Background" Value="{DynamicResource GlassAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Duration x:Key="RinAnimFast">0:0:0.12</Duration>
  <Duration x:Key="RinAppear">0:0:0.187</Duration>
  <Duration x:Key="RinAnim">0:0:0.25</Duration>
  <Duration x:Key="RinExpander">0:0:0.375</Duration>
  <Duration x:Key="RinMiddle">0:0:0.45</Duration>
  <Duration x:Key="RinProgress">0:0:1.55</Duration>
  <QuarticEase x:Key="RinEaseOut" EasingMode="EaseOut" />
  <sys:Double x:Key="RinTitleFontSize">28</sys:Double>
  <sys:Double x:Key="RinSubtitleFontSize">20</sys:Double>
  <sys:Double x:Key="RinBodyLargeFontSize">18</sys:Double>
  <sys:Double x:Key="RinBodyFontSize">14</sys:Double>
  <sys:Double x:Key="RinCaptionFontSize">12</sys:Double>
